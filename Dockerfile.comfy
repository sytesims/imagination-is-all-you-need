# ComfyUI at the pinned core commit + pinned custom-node packs (readiness/manifest/custom-nodes.json).
# TORCH=cu128 (NVIDIA, default) or TORCH=cpu. Local build only; do not push to a public registry.
FROM python:3.12-slim-bookworm
ARG TORCH=cu128
ENV PIP_NO_CACHE_DIR=1 PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends git ffmpeg libgl1 libglib2.0-0 build-essential curl && rm -rf /var/lib/apt/lists/*
WORKDIR /opt
COPY readiness/manifest /opt/manifest
RUN PIN=$(python3 -c "import json;print(json.load(open('/opt/manifest/custom-nodes.json'))['packs']['ComfyUI (core)']['pin'])") \
 && git init -q ComfyUI && cd ComfyUI && git remote add origin https://github.com/comfyanonymous/ComfyUI \
 && git fetch -q --depth 1 origin "$PIN" && git checkout -q FETCH_HEAD
RUN pip install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/${TORCH} \
 && pip install -r /opt/ComfyUI/requirements.txt
RUN bash /opt/manifest/install-custom-nodes.sh /opt/ComfyUI
# Verify every pack is at its pin (retry flaky fetches), pull git submodules (e.g. ComfyUI-F5-TTS -> F5-TTS), fail the build otherwise.
RUN python3 -c "import json;[print(p['dir'],p['pin']) for p in json.load(open('/opt/manifest/custom-nodes.json'))['packs'].values() if p['dir']]" | \
    while read -r dir pin; do d=/opt/ComfyUI/custom_nodes/$dir; \
      for i in 1 2 3; do [ "$(git -C $d rev-parse HEAD 2>/dev/null)" = "$pin" ] && break; \
        echo "retry $dir ($i)"; git -C $d fetch -q --depth 1 origin "$pin" && git -C $d checkout -q FETCH_HEAD \
        && { [ ! -f $d/requirements.txt ] || pip install -q -r $d/requirements.txt; }; done; \
      [ "$(git -C $d rev-parse HEAD 2>/dev/null)" = "$pin" ] || { echo "FAILED $dir"; exit 1; }; \
      if [ -f $d/.gitmodules ]; then git -C $d submodule update -q --init --recursive --depth 1; \
        for s in $(git -C $d config -f .gitmodules --get-regexp path | awk '{print $2}'); do \
          [ -f $d/$s/pyproject.toml ] || [ -f $d/$s/setup.py ] && pip install -q -e $d/$s || true; done; fi; \
      echo "pinned $dir"; done
WORKDIR /opt/ComfyUI
EXPOSE 8188
# models/ is a volume; fill it with: docker compose --profile models run --rm models
CMD ["python", "main.py", "--listen", "0.0.0.0", "--port", "8188"]
