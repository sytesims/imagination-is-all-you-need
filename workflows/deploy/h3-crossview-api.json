  "11": { "class_type": "LoraLoaderModelOnly", "inputs": { "model": ["10", 0], "lora_name": "minimax_h3_ref2v_turbo_8step_v1.0_768p_comfyui_bf16.safetensors", "strength_model": 1.0 }, "_meta": { "title": "8-step turbo LoRA" } },
  "12": { "class_type": "MiniMaxH3SigmaShift", "inputs": { "model": ["11", 0], "shift_video": 12.0, "shift_audio": 3.0 }, "_meta": { "title": "Sigma shift" } },
