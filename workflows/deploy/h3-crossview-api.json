  "15": { "class_type": "CLIPLoader", "inputs": { "clip_name": "qwen3vl_32b_minimax_h3_int8_convrot.safetensors", "type": "minimax", "device": "default" }, "_meta": { "title": "Qwen3-VL text encoder (int8)" } },
