{
  "note": "Project-authored request-contract fixtures for renderBody and render-picker.test.ts. These describe this app's tested requests, not official provider schemas or provider acceptance/quality verification. Authored from the existing builders and assertions; no provider schema/documentation text is copied.",
  "schemas": {
    "kling": {
      "type": "object", "additionalProperties": false,
      "required": ["prompt", "video_list", "mode", "watermark_info"],
      "properties": {
        "prompt": {"type": "string", "minLength": 1},
        "mode": {"enum": ["std", "pro"]},
        "video_list": {
          "type": "array", "minItems": 1, "maxItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["video_url", "refer_type", "keep_original_sound"],
            "properties": {
              "video_url": {"type": "string", "pattern": "^https://"},
              "refer_type": {"const": "base"},
              "keep_original_sound": {"const": "no"}
            }
          }
        },
        "image_list": {
          "type": "array", "minItems": 1, "maxItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["image_url"],
            "properties": {"image_url": {"type": "string", "minLength": 1, "pattern": "^(?!data:)"}}
          }
        },
        "watermark_info": {
          "type": "object", "additionalProperties": false, "required": ["enabled"],
          "properties": {"enabled": {"const": false}}
        }
      }
    },
    "ray": {
      "type": "object", "additionalProperties": false,
      "required": ["prompt", "type", "source", "video"],
      "properties": {
        "prompt": {"type": "string", "minLength": 1},
        "type": {"const": "video_edit"},
        "source": {
          "type": "object", "additionalProperties": false, "required": ["data", "media_type"],
          "properties": {
            "data": {"type": "string", "minLength": 1, "pattern": "^(?!data:)"},
            "media_type": {"const": "video/mp4"}
          }
        },
        "video": {
          "type": "object", "additionalProperties": false, "required": ["resolution", "duration", "edit"],
          "properties": {
            "resolution": {"enum": ["360p", "720p", "1080p"]},
            "duration": {"enum": ["5s", "10s"]},
            "edit": {
              "type": "object", "additionalProperties": false, "required": ["strength"],
              "properties": {"strength": {"const": "adhere_1"}}
            }
          }
        }
      }
    },
    "seed": {
      "type": "object", "additionalProperties": false,
      "required": ["content", "duration", "resolution", "ratio", "generate_audio", "watermark"],
      "properties": {
        "content": {
          "type": "array", "minItems": 2, "maxItems": 3,
          "prefixItems": [
            {
              "type": "object", "additionalProperties": false, "required": ["type", "text"],
              "properties": {"type": {"const": "text"}, "text": {"type": "string", "minLength": 1}}
            },
            {
              "type": "object", "additionalProperties": false, "required": ["type", "video_url", "role"],
              "properties": {
                "type": {"const": "video_url"}, "role": {"const": "reference_video"},
                "video_url": {
                  "type": "object", "additionalProperties": false, "required": ["url"],
                  "properties": {"url": {"type": "string", "pattern": "^https://"}}
                }
              }
            },
            {
              "type": "object", "additionalProperties": false, "required": ["type", "image_url", "role"],
              "properties": {
                "type": {"const": "image_url"}, "role": {"const": "reference_image"},
                "image_url": {
                  "type": "object", "additionalProperties": false, "required": ["url"],
                  "properties": {"url": {"type": "string", "pattern": "^data:image/png;base64,"}}
                }
              }
            }
          ],
          "items": false
        },
        "duration": {"const": -1}, "resolution": {"enum": ["480p", "720p"]},
        "ratio": {"const": "adaptive"}, "generate_audio": {"const": false}, "watermark": {"const": false},
        "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295}
      }
    },
    "aleph": {
      "type": "object", "additionalProperties": false, "required": ["promptText", "videoUri"],
      "properties": {
        "promptText": {"type": "string", "minLength": 1, "maxLength": 1000},
        "videoUri": {"type": "string", "pattern": "^data:video/mp4;base64,"},
        "promptImage": {
          "type": "array", "minItems": 1, "maxItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["uri", "position"],
            "properties": {"uri": {"type": "string", "pattern": "^data:image/png;base64,"}, "position": {"const": "first"}}
          }
        },
        "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295}
      }
    }
  }
}
