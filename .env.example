# Imagination Is All You Need environment variables (example only: placeholders / empty values).
# Copy to .env.local (the server reads only .env.local) and fill in what you need. Never commit a real .env.local (it is gitignored; only this file is tracked).
# Every OPENHIGGSFIELD_* name also accepts the legacy OPENJUTSU_* prefix.

# ---- Server ----
PORT=8787
HOST=
OPENHIGGSFIELD_BACKEND=                     # comfy (default: real runs) | mock (development and tests only: sample results)
OPENHIGGSFIELD_DATA_DIR=                    # default: server/data
OPENHIGGSFIELD_ALLOWED_HOSTS=               # extra host names the app answers to (default: localhost and IP addresses only), e.g. mymac.local
OPENHIGGSFIELD_ALLOWED_ORIGINS=             # extra websites allowed to call the API from a browser, e.g. https://tools.example.com
OPENHIGGSFIELD_PUBLIC_BASE_URL=             # e.g. https://your.host (share links, webhooks)
OPENHIGGSFIELD_PUBLIC_API=
OPENHIGGSFIELD_REPO_URL=
OPENHIGGSFIELD_HOSTED=                      # 1 = hosted mode (signup grant, no local paths in MCP info)
OPENHIGGSFIELD_SIGNUP_GRANT=10
OPENHIGGSFIELD_RESULT_TTL_DAYS=0            # 0 = keep results forever
OPENHIGGSFIELD_TRASH_DAYS=30
OPENHIGGSFIELD_REQUEUE_ON_RESTART=
OPENHIGGSFIELD_PLUGINS_DIR=                 # default: plugins/
OPENHIGGSFIELD_PYTHON=
OPENHIGGSFIELD_PY=
OPENHIGGSFIELD_HUB_LIVE=

# ---- Queue / credits ----
OPENHIGGSFIELD_CONCURRENCY=2
OPENHIGGSFIELD_MAX_PARALLEL=6
OPENHIGGSFIELD_MAX_PARALLEL_FREE=2
OPENHIGGSFIELD_MAX_QUEUED=20
OPENHIGGSFIELD_FREE_LANE_DELAY_MS=
OPENHIGGSFIELD_GPU_CREDITS=36000            # starting balance (1 credit = $0.01)
OPENHIGGSFIELD_FREE_GENS=3
OPENHIGGSFIELD_CANCEL_IN_PROCESSING=        # 1 = allow cancelling running jobs (full refund)
OPENHIGGSFIELD_DEV_GRANT=                   # 1 = allow POST /api/ledger/grant outside mock

# ---- Routing (cloud first; local opt-in) ----
OPENHIGGSFIELD_USE_LOCAL=                   # 1 = prefer local ComfyUI routes
OPENHIGGSFIELD_LOCAL_AVAILABLE=
OPENHIGGSFIELD_OPEN_WEIGHTS_ONLY=           # 1 = hide hosted APIs / partner nodes (Comfy Cloud open-weight workflows stay)
OPENHIGGSFIELD_COMMERCIAL=                  # read but has no effect (defaults never change on a licence setting)
OPENHIGGSFIELD_ROUTING_LIVE=
OPENHIGGSFIELD_ROUTING_TIMEOUT_MS=
OPENHIGGSFIELD_ROUTING_FAIL=                # QA: force route failures (mock)
OPENHIGGSFIELD_SWAP_WORKFLOWS=
OPENHIGGSFIELD_SWAP_MULTI_REF=
OPENHIGGSFIELD_RESHOOT_ENGINE=
OPENHIGGSFIELD_VOICE_RUNNER=

# ---- Mock / QA (mock backend only) ----
OPENHIGGSFIELD_MOCK_KEYS=                   # 1 = treat hosted keys as present (no real calls)
OPENHIGGSFIELD_MOCK_DELAY_MS=
OPENHIGGSFIELD_MOCK_FAIL=                   # 1 or an error type: temporary | provider_outage | ip | nsfw
OPENHIGGSFIELD_DEMO=                        # 1 = demo mode: seed the Community feed even with BACKEND=comfy
OPENHIGGSFIELD_SEED_COMMUNITY=              # 0 = don't seed the Community feed (seeded by default in mock/demo mode)
OPENHIGGSFIELD_CAPTURE_GRAPHS=

# ---- Local ComfyUI ----
COMFY_BASE_URL=                             # e.g. http://127.0.0.1:8188
OPENHIGGSFIELD_COMFY_MODELS_DIR=
OPENHIGGSFIELD_COMFY_TIMEOUT_MS=1800000
# OPENHIGGSFIELD_WORKFLOW=object-swap-wan-animate-api.json   # code default; set object-swap-api.json for the legacy graph
OPENHIGGSFIELD_NODE_IMAGE=10:image
OPENHIGGSFIELD_NODE_VIDEO=145:file
OPENHIGGSFIELD_NODE_PROMPT=21:text
OPENHIGGSFIELD_NODE_OUTPUT=277

# ---- Cloud provider keys (leave empty unless you use that provider) ----
COMFY_API_KEY=                              # Comfy API: partner nodes, Comfy Router, Comfy Cloud
COMFY_DEPLOY_URL=                           # Your Comfy deployment (a Build on platform.comfy.org): https://<name>.run.comfy.app; uses COMFY_API_KEY
COMFY_RUNNER_URL=                           # Optional instead: any Comfy API v2 host, e.g. comfy-api-proxy on a rented GPU (http://<host>:8189)
COMFY_RUNNER_TOKEN=                         # Optional: that proxy's --token (leave empty if its auth is off)
OPENHIGGSFIELD_COMFY_API=
OPENHIGGSFIELD_COMFY_ROUTER_URL=
OPENHIGGSFIELD_FAL_KEY=                     # alias: FAL_KEY
FAL_KEY=
OPENHIGGSFIELD_REPLICATE_API_TOKEN=         # alias: REPLICATE_API_TOKEN
REPLICATE_API_TOKEN=
OPENHIGGSFIELD_BFL_API_KEY=                 # Black Forest Labs (official lab key)
OPENHIGGSFIELD_BFL_BASE_URL=                # optional: https://api.eu.bfl.ai or https://api.us.bfl.ai (default https://api.bfl.ai)
OPENHIGGSFIELD_MINIMAX_API_KEY=             # MiniMax pay-as-you-go key (official lab key)
OPENHIGGSFIELD_MINIMAX_BASE_URL=            # optional: https://api.minimaxi.com for China keys (default https://api.minimax.io)
OPENHIGGSFIELD_LTX_API_KEY=                 # LTX (Lightricks) official API key
OPENHIGGSFIELD_OPENAI_API_KEY=              # OpenAI API key (GPT Image; some models need a verified organization)
OPENHIGGSFIELD_GEMINI_API_KEY=              # Google Gemini API key (Nano Banana; from Google AI Studio)
OPENHIGGSFIELD_ARK_API_KEY=                 # BytePlus ModelArk API key (Seedance, Seedream; activate each model in the console)
OPENHIGGSFIELD_ARK_BASE_URL=                # optional: default https://ark.ap-southeast.bytepluses.com/api/v3 (video runs only there)
OPENHIGGSFIELD_DASHSCOPE_API_KEY=
OPENHIGGSFIELD_LUMA_API_KEY=

# ---- Prompt enhance / translate (optional) ----
OPENHIGGSFIELD_ENHANCE_LLM_URL=
OPENHIGGSFIELD_ENHANCE_LLM_MODEL=
OPENHIGGSFIELD_TRANSLATE_URL=
OPENHIGGSFIELD_TRANSLATE_KEY=

# ---- Web (Vite dev server) ----
WEB_PORT=5174
OPENHIGGSFIELD_API_PROXY=                   # default http://localhost:8787
WEB_URL=

# ---- MCP server ----
OPENHIGGSFIELD_API=http://127.0.0.1:8787
OPENHIGGSFIELD_MCP_URL=
OPENHIGGSFIELD_MCP_POLL_MS=
MCP_TRANSPORT=                              # stdio | http
MCP_HOST=127.0.0.1
MCP_PORT=8788
OPENHIGGSFIELD_MCP_PERMISSIONS=             # path to a permissions JSON
OPENHIGGSFIELD_MCP_DEFAULT=                 # allow | ask | block
OPENHIGGSFIELD_MCP_ALLOW=
OPENHIGGSFIELD_MCP_ASK=
OPENHIGGSFIELD_MCP_BLOCK=
